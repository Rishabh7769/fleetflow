generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())

  name      String
  phone     String
  address   String?
  gstNumber String?

  users User[]
  vehicles Vehicle[]
  drivers Driver[]
  customers Customer[]
  trips Trip[]
  tripExpenses TripExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum UserRole {
  OWNER
  MANAGER
  DISPATCHER
  DRIVER
}
enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  OUT_OF_SERVICE
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  LNG
  ELECTRIC
}
model User {
  id         String   @id @default(cuid())

  name       String
  email      String   @unique
  password   String

  role       UserRole @default(OWNER)

  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model Vehicle {
  id String @id @default(cuid())

  registrationNumber String @unique

  manufacturer String

  model String

  year Int

  vehicleType String

  fuelType FuelType

  capacity Float

  currentOdometer Int @default(0)

  engineNumber String?

  chassisNumber String?

  vin String?

  insuranceExpiry DateTime?

  permitExpiry DateTime?

  fitnessExpiry DateTime?

  pucExpiry DateTime?

  averageMileage Float?

  gpsDeviceId String?

  status VehicleStatus @default(AVAILABLE)

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  trips Trip[] @relation("VehicleTrips")
}
model Driver {
  id              String   @id @default(cuid())

  name            String
  email           String?  @unique
  phone           String

  licenseNumber   String   @unique
  licenseExpiry   DateTime

  address         String?

  emergencyName   String?
  emergencyPhone  String?

  bloodGroup      String?

  status          DriverStatus @default(ACTIVE)

  companyId       String
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  trips Trip[] @relation("DriverTrips")
}

enum DriverStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}
model Customer {
  id          String   @id @default(cuid())

  name        String
  companyName String?

  phone       String
  email       String?

  gstNumber   String?

  address     String?

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  trips Trip[] @relation("CustomerTrips")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Trip {
  id String @id @default(cuid())

  tripNumber String @unique

  customerId String
  customer Customer @relation("CustomerTrips", fields:[customerId], references:[id])

  driverId String
  driver Driver @relation("DriverTrips", fields: [driverId], references: [id])

  vehicleId String
  vehicle Vehicle @relation("VehicleTrips", fields: [vehicleId], references: [id])

 pickupAddress String

pickupCity String

pickupState String

pickupPincode String?

deliveryAddress String

deliveryCity String

deliveryState String

deliveryPincode String?

  freightAmount Decimal
  advanceReceived Decimal @default(0)

  status TripStatus @default(CREATED)

  startDate DateTime?
  deliveryDate DateTime?
  expectedDeliveryDate DateTime?

  remarks String?

  expenses TripExpense[]

  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  estimatedDistance Float?

actualDistance Float?
}
enum TripStatus{
  CREATED
  ASSIGNED
  STARTED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}
model TripExpense{
  id String @id @default(cuid())
  companyId String

company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tripId String
  trip Trip @relation(fields:[tripId], references:[id], onDelete:Cascade)

  type ExpenseType

  amount Decimal

  title String?
  receiptUrl String?

  expenseDate DateTime

createdAt DateTime @default(now())
}
enum ExpenseType{
  FUEL
  TOLL
  DRIVER
  REPAIR
  FOOD
  PARKING
  OTHER
}